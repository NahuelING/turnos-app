# Copia este archivo a `.env` y completa los valores.
# Las claves están en: Supabase Dashboard -> Project Settings -> API

# URL del proyecto (columna "Project URL")
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave pública "anon" public (puede ir en el frontend)
SUPABASE_ANON_KEY=

# Clave "service_role" (SOLO backend, jamás expuesta al frontend)
SUPABASE_SERVICE_KEY=

# Secreto JWT (Project Settings -> API -> JWT Secret)
SUPABASE_JWT_SECRET=

# development | production
APP_ENV=development

# Puerto del servidor Flask (opcional, por defecto 5000)
PORT=5000